{
  "name": "cisco-ios",
  "description": "Cisco IOS and IOS XE (Catalyst switches and routers)",
  "promptPattern": "^[\\w.\\-/()+@:~ ]*[>#]\\s*$",
  "userPromptPattern": ">\\s*$",
  "privilegedPromptPattern": "#\\s*$",
  "configPromptPattern": "\\(config[^)]*\\)#\\s*$",
  "pagerPattern": "--More--\\s*$",
  "pagerKey": " ",
  "disablePagerCommand": "terminal length 0",
  "errorPattern": "^%\\s",
  "confirmPattern": "\\[confirm\\]\\s*$",
  "yesNoPattern": "\\[yes/no\\]:?\\s*$",
  "passwordPromptPattern": "(password|passphrase|passcode)[^:\\r\\n]*:\\s*$",
  "userNamePromptPattern": "(user ?name|login)[^:\\r\\n]*:\\s*$",
  "readOnlyPattern": "^\\s*(s(h(o(w)?)?)?|ping|traceroute|terminal\\s+(length|width)\\s+\\d+|dir|more|verify)(\\s|$)",
  "readOnlyDenyPattern": "\\|\\s*(redirect|tee|append)\\b|[\\x00-\\x1f]",
  "enableCommand": "enable",
  "configureCommand": "configure terminal",
  "endConfigCommand": "end",
  "saveCommand": "write memory",
  "reloadInCommand": "reload in {minutes}",
  "reloadCancelCommand": "reload cancel"
}
