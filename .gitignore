# Compiled core (regenerated on first run from src/Core/*.cs)
bin/

# Build output
dist/
PSTerm-Compiled/

# Session logs
Logs/
*.log

# Local secrets and migration backups - never commit these
Profiles/credentials.dat
Profiles/*.v1-backup
Profiles/*.corrupt-*
Profiles/settings.json

# Saved connections hold real hostnames and usernames. The app creates a starter
# file on first run, so there is nothing to ship.
Profiles/profiles.json
Profiles/profiles.json.tmp

# Code signing artefacts
*.cer
*.pfx
